<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox — required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- User-selected file read/write — for folder picker (NSOpenPanel) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder read — for cleanup scan -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Network client — for signature DB updates -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Temporary exception: read ~/Library for cache/log scanning -->
    <!-- NOTE: Full Disk Access is requested at runtime via user prompt, not via entitlement -->
    <!-- The entitlement below covers the subset needed within sandbox -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Caches/</string>
        <string>/Library/Logs/</string>
        <string>/Library/Preferences/</string>
        <string>/Library/Application Support/</string>
        <string>/.Trash/</string>
        <string>/Downloads/</string>
    </array>

    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.halo.mac</string>
    </array>

    <!-- F-025 Similar Photos: the Photos Library entitlement is deliberately
         NOT here.

         It lives in Halo-Debug.entitlements only. Shipping it in the release /
         App Store configuration expands the App Privacy nutrition label and puts
         a permission prompt in front of users, for a code path this PR itself
         labels experimental and which has never been runtime-tested. The
         loose-file half of the feature — the tested v1 scope — needs no
         entitlement at all and is unaffected.

         Because the key is absent, `PerceptualDuplicateDetector`'s
         `isPhotosLibraryReachable` returns false in this configuration and the
         Photos Library row is hidden from `SimilarPhotosView` entirely — a
         sandboxed build would otherwise offer a button that always fails and
         then point the user at System Settings, where nothing they can do would
         help. The loose-file half of F-025 needs no entitlement and is
         unaffected.

         Move this key here once the grant flow has actually been exercised.
         The check reads the entitlement at runtime, so adding it here is the
         only change needed — the UI reappears on its own. -->
</dict>
</plist>
