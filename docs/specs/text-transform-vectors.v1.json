      "expected": "{\n    \"b\": 1,\n    \"a\": [\n        1,\n        2,\n        {\n            \"c\": null\n        }\n    ],\n    \"d\": \"x\"\n}"
    },
    {
      "id": "format_json-01",
      "transform": "format_json",
      "input": "[]",
      "expected": "[]"
    },
    {
